{
  "name": "break-a-leg",
  "version": "0.2.0",
  "private": true,
  "description": "Give your mobile app a security rehearsal before launch.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=15000 tests/*.test.mjs",
    "demo": "node tests/demo.mjs",
    "bundle": "node scripts/bundle.mjs",
    "check:bundle": "node scripts/bundle.mjs --check",
    "discover": "node runner/cli.ts discover",
    "validate": "node runner/cli.ts validate",
    "run": "node runner/cli.ts run",
    "typecheck": "tsc --noEmit",
    "test:installer": "python3 -m unittest discover -s tests -p \"test_installer.py\"",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "check:docs": "python3 scripts/check_docs.py"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/notsocj/break-a-leg.git"
  },
  "homepage": "https://github.com/notsocj/break-a-leg#readme",
  "bugs": {
    "url": "https://github.com/notsocj/break-a-leg/issues"
  }
}
